@model WebApplication1.ViewModels.HomeViewModel

@section Styles {
    <style>
        .book-card {
            border: 1px solid #ccc;
            padding: 10px;
            margin: 5px;
            width: 220px;
            display: inline-block;
            vertical-align: top;
        }
    </style>
}

@section Scripts {
    <script>
        function confirmRemove() {
            return confirm("Remove this book?");
        }
    </script>
}

<h3>Add Book</h3>
<form method="post" action="/Home/AddBook">
    <div>
        <label>Title</label><br />
        <input type="text" name="Title" required />
    </div>
    <div>
        <label>Price</label><br />
        <input type="number" step="0.01" name="Price" required />
    </div>
    <div>
        <label>Author</label><br />
        <select name="Author" required>
            @foreach (var author in Model.Authors)
            {
                <option value="@author.Id">@author.Name</option>
            }
        </select>
    </div>
    <button type="submit" class="mt-2">Add Book</button>
</form>

<hr />

<h3>Add Author</h3>
<form method="post" action="/Home/AddAuthor">
    <div>
        <label>Name</label><br />
        <input type="text" name="Name" required />
    </div>
    <div>
        <label>Country</label><br />
        <input type="text" name="Country" required />
    </div>
    <button type="submit" class="mt-2">Add Author</button>
</form>

<hr />

<h3>Books List</h3>
@if (!Model.Books.Any())
{
    <p>No books available</p>
}
else
{
    <div>
        @foreach (var book in Model.Books)
        {
            <div class="book-card">
                <h5>@book.Title</h5>
                <p>Author: @book.AuthorName</p>
                <p>Price: $@book.Price</p>
                <form method="post" action="/Home/RemoveBook" onsubmit="return confirmRemove();">
                    <input type="hidden" name="id" value="@book.Id" />
                    <button type="submit">Remove</button>
                </form>
            </div>
        }
    </div>
}